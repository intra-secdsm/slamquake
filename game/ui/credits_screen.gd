class_name CreditsScreen
extends Control
## Credits and licenses: who and what made the game, then the Godot Engine license and
## every third-party component built into the engine, read from the engine itself so it
## always matches the build. (The same text ships as docs/THIRD_PARTY_NOTICES.md.)

signal closed

const CREDITS := """[font_size=56][color=#ff2bd6]SLAMQUAKE![/color] [color=#ffd400]Suplex Spectacular![/color][/font_size]

An original game. All wrestlers, names, gimmicks and promotions are fictional.
The game's code and assets are released under the [b]MIT License[/b] (see LICENSE).

[color=#00e5ff][b]MADE WITH[/b][/color]
[b]Godot Engine[/b]: the game engine (MIT License, license text and components below). godotengine.org
[b]Blender[/b]: every 3D model and animation is generated by the project's own Python scripts
    running in Blender (GPL; Blender itself isn't included, and what it outputs isn't covered by its license). blender.org
[b]Audio[/b]: all music and sound effects are synthesized by the project's own scripts (CC0).
[b]Box art[/b]: generated with ChatGPT (OpenAI).
[b]Development[/b]: built with the help of Claude Code (Anthropic).
[b]Tests[/b]: GUT, the Godot Unit Test framework (MIT; not part of the game build).
"""

var _text: RichTextLabel


func _init() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	visible = false
	var shade := ColorRect.new()
	shade.color = Color(0.02, 0.0, 0.06, 0.92)
	shade.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	add_child(shade)
	var box := VBoxContainer.new()
	box.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	box.offset_left = 120
	box.offset_right = -120
	box.offset_top = 60
	box.offset_bottom = -50
	box.add_theme_constant_override("separation", 16)
	add_child(box)
	var title := Label.new()
	title.text = "CREDITS & LICENSES"
	title.add_theme_font_size_override("font_size", 64)
	title.add_theme_color_override("font_color", Color("ff2bd6"))
	title.add_theme_color_override("font_outline_color", Color("00e5ff"))
	title.add_theme_constant_override("outline_size", 8)
	box.add_child(title)
	_text = RichTextLabel.new()
	_text.bbcode_enabled = true
	_text.size_flags_vertical = Control.SIZE_EXPAND_FILL
	_text.focus_mode = Control.FOCUS_ALL
	_text.selection_enabled = false
	_text.add_theme_font_size_override("normal_font_size", 22)
	_text.add_theme_font_size_override("bold_font_size", 22)
	box.add_child(_text)
	var hint := Label.new()
	hint.text = "↑↓ / mouse wheel: scroll    Esc / B: back"
	hint.add_theme_font_size_override("font_size", 18)
	box.add_child(hint)


func open() -> void:
	if _text.text == "":
		_text.text = CREDITS + "\n" + engine_notices()
	visible = true
	_text.scroll_to_line(0)
	_text.grab_focus()


func close() -> void:
	visible = false
	closed.emit()


func _unhandled_input(event: InputEvent) -> void:
	if not visible:
		return
	var bar := _text.get_v_scroll_bar()
	if event.is_action_pressed("ui_down"):
		bar.value += 120
	elif event.is_action_pressed("ui_up"):
		bar.value -= 120
	elif event.is_action_pressed("ui_cancel"):
		close()
	else:
		return
	get_viewport().set_input_as_handled()


## Godot's license, each built-in third-party component with its copyright and license,
## and the full text of every license they use, as BBCode.
static func engine_notices() -> String:
	var out := PackedStringArray()
	out.append("[color=#00e5ff][b]GODOT ENGINE %s[/b][/color]" % Engine.get_version_info()["string"])
	out.append(_plain(Engine.get_license_text()))
	out.append("\n[color=#00e5ff][b]THIRD-PARTY COMPONENTS IN THE ENGINE[/b][/color]")
	for c: Dictionary in Engine.get_copyright_info():
		var lines := PackedStringArray()
		for part: Dictionary in c["parts"]:
			for line: String in part["copyright"]:
				lines.append("© " + _plain(line))
			lines.append("License: " + _plain(part["license"]))
		out.append("[b]%s[/b]\n%s" % [_plain(c["name"]), "\n".join(lines)])
	out.append("\n[color=#00e5ff][b]LICENSE TEXTS[/b][/color]")
	var info := Engine.get_license_info()
	var names := info.keys()
	names.sort()
	for n: String in names:
		out.append("[b]%s[/b]\n%s" % [_plain(n), _plain(info[n])])
	return "\n\n".join(out)


## Text shown literally (license texts can contain square brackets).
static func _plain(s: String) -> String:
	return s.strip_edges().replace("[", "[lb]")
